# Konkan — environment variables
# Copy this file to `.env` for local dev, then also set each value in
# your Vercel project (Settings → Environment Variables → Production).

# ── Supabase ───────────────────────────────────────────────────────────────
# From: https://app.supabase.com → Project Settings → API
# VITE_ prefix is required so Vite exposes them to the client bundle
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON=eyJhbGciOi...your-anon-public-key...

# ── Optional ───────────────────────────────────────────────────────────────
# Override the URL used in auth-emails and Supabase redirects.
# If unset, the code falls back to `window.location.origin` at runtime —
# which is correct on both localhost and the deployed site.
# VITE_APP_URL=https://konkan-konkan.vercel.app

# ── Konkan AI (server-side, never use the VITE_ prefix) ─────────────────────
# Create a Gemini API key in Google AI Studio and add it to Vercel.
GEMINI_API_KEY=your-gemini-api-key
# Optional override; the app defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
